# Copy this file to .env and fill in the keys you have. The app works fine
# with just one key set - any source left blank is simply skipped (its
# option is disabled in the Source filter).

# https://newsapi.org/register (free tier)
VITE_NEWSAPI_KEY=

# https://open-platform.theguardian.com/access/ (free "Developer" tier)
VITE_GUARDIAN_API_KEY=

# https://developer.nytimes.com/get-started (free, use the "Article Search API" app)
VITE_NYTIMES_API_KEY=
