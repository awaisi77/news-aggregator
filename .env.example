# Copy this file to .env and fill in the keys you have. The app works fine
# with just one key set - any source left blank is simply skipped (its
# option is disabled in the Source filter).

# https://newsapi.org/register (free tier)
# Server-only: used by /api/news (Vite proxy, Vercel function, Docker nginx).
# The Developer plan blocks browser calls from any origin other than localhost.
NEWSAPI_KEY=

# Set to true so the UI enables NewsAPI without putting the key in the JS bundle.
# Required on Vercel if you only set NEWSAPI_KEY (do not set VITE_NEWSAPI_KEY there).
VITE_NEWSAPI_ENABLED=

# Optional legacy alias. Still enables the NewsAPI source in the UI and is
# accepted by the proxy if NEWSAPI_KEY is empty. Avoid on Vercel — Vite inlines it.
VITE_NEWSAPI_KEY=

# https://open-platform.theguardian.com/access/ (free "Developer" tier)
VITE_GUARDIAN_API_KEY=

# https://developer.nytimes.com/get-started (free, use the "Article Search API" app)
VITE_NYTIMES_API_KEY=
